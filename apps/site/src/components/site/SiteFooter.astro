---
import { ROUTES, href } from "../../lib/routes";

const REPOSITORY = "https://github.com/nphkhiem/knowledge-hub";
---

<footer class="site-footer">
  <div class="page-width footer-inner">
    <div class="identity">
      <strong>Knowledge Hub</strong>
      <p>Visual mental models for practical software development.</p>
    </div>
    <nav class="utility" aria-label="Utility">
      <a href={href(ROUTES.about)}>About</a>
      <a href={href(ROUTES.accessibility)}>Accessibility</a>
      <a href={REPOSITORY}>Source</a>
      <!-- Contribution is optional and stays last, per the approved
      information architecture. -->
      <a href={`${REPOSITORY}/blob/main/CONTRIBUTING.md`}>
        Contribute on GitHub
      </a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--section-space);
    border-top: var(--border-width-thin) solid var(--color-border-subtle);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    padding-block: var(--space-8);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  .footer-inner strong {
    color: var(--color-text-primary);
  }

  .footer-inner p {
    margin: 0;
  }

  .identity {
    display: grid;
    gap: var(--space-2);
  }

  .utility {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
  }

  .utility a {
    display: inline-flex;
    min-height: var(--control-target-min);
    align-items: center;
    color: var(--color-text-secondary);
  }

  .utility a:hover,
  .utility a:focus-visible {
    color: var(--color-text-primary);
  }
</style>
