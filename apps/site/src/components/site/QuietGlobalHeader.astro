---
import { ROUTES, href } from "../../lib/routes";
---

<header class="global-header">
  <div class="page-width header-inner">
    <a class="brand" href={href(ROUTES.home)} aria-label="Knowledge Hub home">
      <span aria-hidden="true" class="brand-mark">KH</span>
      <span>Knowledge Hub</span>
    </a>
    <nav class="primary" aria-label="Primary">
      <a href={href(ROUTES.explore)}>Explore</a>
    </nav>
  </div>
</header>

<style>
  .global-header {
    min-height: var(--header-height);
    border-bottom: var(--border-width-thin) solid var(--color-border-subtle);
    background: rgb(243 243 232 / 94%);
  }

  .header-inner {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .primary {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .primary a {
    display: inline-flex;
    min-height: var(--control-target-min);
    align-items: center;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .primary a:hover,
  .primary a:focus-visible {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .brand {
    display: inline-flex;
    min-height: var(--control-target-min);
    align-items: center;
    gap: var(--space-5);
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: var(--border-width-strong) solid var(--color-accent-secondary);
    border-radius: var(--border-radius-sm);
    color: var(--color-accent-secondary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
  }
</style>
