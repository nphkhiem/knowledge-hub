---
import type { CompiledLesson } from "@knowledge-hub/lesson-compiler";

interface Props {
  lesson: CompiledLesson;
}

const { lesson } = Astro.props;
---

<div
  class="utilities"
  data-lesson-utilities
  data-lesson-id={lesson.id}
  data-lesson-title={lesson.title}
>
  <button type="button" data-utility-bookmark aria-pressed="false" hidden>
    Bookmark
  </button>
  <button type="button" data-utility-complete hidden>Mark completed</button>
  <button type="button" data-utility-share hidden>Share</button>
  <p class="status" role="status" data-utility-status></p>
  <p class="scope">Kept in this browser only.</p>
</div>

<script>
  import { bootstrapLessonUtilities } from "../../lib/bootstrapLessonUtilities";

  for (const root of document.querySelectorAll("[data-lesson-utilities]")) {
    if (root instanceof HTMLElement) bootstrapLessonUtilities(root);
  }
</script>

<style>
  .utilities {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  button {
    min-height: var(--control-target-min);
    padding-inline: var(--control-padding-inline);
    border: var(--border-width-thin) solid var(--color-border-secondary);
    border-radius: var(--border-radius-sm);
    background: transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
  }

  button[aria-pressed="true"] {
    border-color: var(--color-border-primary);
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  button:disabled {
    border-style: dashed;
    color: var(--color-text-tertiary);
    cursor: default;
  }

  button:focus-visible {
    outline: var(--border-width-strong) solid var(--color-border-focus);
    outline-offset: 2px;
  }

  .status:empty {
    display: none;
  }

  .status {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  .scope {
    flex-basis: 100%;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-xs);
  }
</style>
