---
interface Neighbor {
  readonly title: string;
  readonly href: string;
}

interface Props {
  previous?: Neighbor;
  next?: Neighbor;
}

const { previous, next } = Astro.props;
/**
 * Only published neighbors are accepted, so during the first slice, when no
 * other lesson exists yet, nothing renders rather than offering dead links.
 */
const hasNeighbors = previous !== undefined || next !== undefined;
---

{
  hasNeighbors && (
    <nav class="neighbors" aria-label="Nearby lessons">
      {previous !== undefined && (
        <a class="previous" href={previous.href}>
          <span class="direction">Previous lesson</span>
          <span class="title">{previous.title}</span>
        </a>
      )}
      {next !== undefined && (
        <a class="next" href={next.href}>
          <span class="direction">Next lesson</span>
          <span class="title">{next.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .neighbors {
    display: grid;
    gap: var(--space-5);
  }

  a {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    border: var(--border-width-thin) solid var(--color-border-secondary);
    border-radius: var(--border-radius-md);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  a:hover {
    background: var(--color-bg-secondary);
  }

  a:focus-visible {
    outline: var(--border-width-strong) solid var(--color-border-focus);
    outline-offset: 2px;
  }

  .direction {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .title {
    font-size: var(--font-size-md);
  }

  @media (min-width: 48rem) {
    .neighbors {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }

    .next {
      text-align: right;
    }
  }
</style>
