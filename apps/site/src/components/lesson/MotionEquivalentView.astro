---
import type { CompiledLesson } from "@knowledge-hub/lesson-compiler";
import { renderMotionEquivalent } from "@knowledge-hub/lesson-renderer";

interface Props {
  lesson: CompiledLesson;
}

const { lesson } = Astro.props;
const steps = renderMotionEquivalent(lesson);
const labelId = "motion-equivalent-label";
---

<div class="motion-equivalent">
  <p class="label" id={labelId}>{lesson.accessibility.motionEquivalentLabel}</p>
  <ol aria-labelledby={labelId} data-motion-equivalent>
    {
      steps.map((step) => (
        <li>
          <figure>
            <span class="step-number" data-step-number>
              {step.stepNumber}
            </span>
            <div class="figure-frame" set:html={step.markup} />
            <figcaption>{step.narration}</figcaption>
          </figure>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .motion-equivalent {
    display: grid;
    gap: var(--space-6);
  }

  .label {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  ol {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--space-7);
    list-style: none;
  }

  figure {
    display: grid;
    margin: 0;
    gap: var(--space-4);
    padding: var(--space-6);
    border: var(--border-width-thin) solid var(--color-border-secondary);
    border-radius: var(--border-radius-md);
    background: var(--color-visual-bg);
  }

  .step-number {
    display: inline-grid;
    width: 1.75rem;
    height: 1.75rem;
    align-content: center;
    justify-content: center;
    border: var(--border-width-thin) solid var(--color-border-primary);
    border-radius: var(--border-radius-full);
    color: var(--color-text-secondary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
  }

  .figure-frame :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    color: var(--color-text-primary);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
  }
</style>
