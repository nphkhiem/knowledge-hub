---
import type { CompiledLesson } from "@knowledge-hub/lesson-compiler";

interface Props {
  lesson: CompiledLesson;
}

const { lesson } = Astro.props;
const { evidence } = lesson;
---

<div class="evidence">
  <p class="scope">{evidence.scope}</p>
  <ul>
    {
      evidence.sources.map((source) => (
        <li>
          <p class="title">
            {source.url === undefined ? (
              source.title
            ) : (
              <a href={source.url} rel="noreferrer">
                {source.title}
              </a>
            )}
          </p>
          <p class="meta">
            {source.publisher}
            {source.citation === undefined ? "" : `. ${source.citation}`}
          </p>
          <ul class="supports">
            {source.supports.map((claim) => (
              <li>{claim}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
  <p class="verified">
    Sources checked on <time datetime={evidence.verifiedOn}>
      {evidence.verifiedOn}
    </time>.
  </p>
</div>

<style>
  .evidence {
    display: grid;
    gap: var(--space-6);
  }

  .scope {
    padding: var(--space-5) var(--space-6);
    border-left: var(--border-width-strong) solid var(--color-constraint-rule);
    background: var(--color-bg-secondary);
    color: var(--color-text-primary);
    line-height: var(--line-height-relaxed);
  }

  ul {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--space-6);
    list-style: none;
  }

  .title {
    color: var(--color-text-primary);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
  }

  .meta {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  .supports {
    margin-block-start: var(--space-4);
    gap: var(--space-2);
    padding-inline-start: var(--space-6);
    list-style: disc;
  }

  .supports li {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .verified {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-sm);
  }
</style>
