---
import type { CompiledLesson } from "@knowledge-hub/lesson-compiler";
import { renderSnapshot } from "@knowledge-hub/lesson-renderer";
import { serializeForHtml } from "../../lib/serializeForHtml";

interface Props {
  lesson: CompiledLesson;
}

const { lesson } = Astro.props;
const first = lesson.snapshots[0];
if (first === undefined) {
  throw new Error(`Lesson "${lesson.id}" compiled without any snapshot.`);
}
const opening = renderSnapshot(first);
---

<figure class="visual-brief" data-visual-brief data-step-index="0">
  <div class="stage" data-snapshot-host set:html={opening.markup} />
  <figcaption>
    <p class="narration" data-narration aria-live="off">{first.narration}</p>
    <button
      class="control"
      type="button"
      aria-label="Resume animation"
      data-visual-brief-control
      hidden
    >
      Resume
    </button>
  </figcaption>
  <script
    type="application/json"
    data-compiled-lesson
    is:inline
    set:html={serializeForHtml(lesson)}
  />
</figure>

<script>
  import { mountVisualBrief } from "../../lib/visualBriefController";

  for (const root of document.querySelectorAll("[data-visual-brief]")) {
    const data = root.querySelector("[data-compiled-lesson]");
    if (!(root instanceof HTMLElement) || data === null) continue;
    try {
      mountVisualBrief(root, JSON.parse(data.textContent ?? ""));
    } catch {
      /* The prerendered figure and the step sequence already carry the lesson. */
    }
  }
</script>

<style>
  .visual-brief {
    display: grid;
    margin: 0;
    gap: var(--space-5);
  }

  .stage {
    border: var(--border-width-thin) solid var(--color-border-secondary);
    border-radius: var(--border-radius-md);
    background: var(--color-visual-bg);
  }

  .stage :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .narration {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
  }

  .control {
    min-height: var(--control-target-min);
    padding-inline: var(--control-padding-inline);
    border: var(--border-width-thin) solid var(--color-border-primary);
    border-radius: var(--border-radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text-primary);
    font-family: var(--font-family-body);
    font-size: var(--font-size-sm);
  }

  .control:hover {
    background: var(--color-bg-tertiary);
  }

  .control:focus-visible {
    outline: var(--border-width-strong) solid var(--color-border-focus);
    outline-offset: 2px;
  }
</style>
