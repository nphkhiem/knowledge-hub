---
import type { CompiledLesson } from "@knowledge-hub/lesson-compiler";
import LessonExamples from "./LessonExamples.astro";

interface Props {
  lesson: CompiledLesson;
}

const { lesson } = Astro.props;
const deepDive = lesson.content.deepDive;
const examples = lesson.content.examples ?? [];
---

{
  (deepDive !== undefined || examples.length > 0) && (
    <details class="deep-dive">
      <summary>Deep dive</summary>
      <div class="deep-dive-body">
        {deepDive !== undefined && (
          <div class="prose" set:html={deepDive.html} />
        )}
        {examples.length > 0 && <LessonExamples examples={examples} />}
      </div>
    </details>
  )
}

<style>
  .deep-dive {
    border: var(--border-width-thin) solid var(--color-border-secondary);
    border-radius: var(--border-radius-md);
    background: var(--color-bg-secondary);
  }

  summary {
    padding: var(--space-5) var(--space-6);
    color: var(--color-text-primary);
    cursor: pointer;
    font-family: var(--font-family-body);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
  }

  summary:focus-visible {
    outline: var(--border-width-strong) solid var(--color-border-focus);
    outline-offset: 2px;
  }

  .deep-dive-body {
    display: grid;
    gap: var(--space-7);
    padding: 0 var(--space-6) var(--space-7);
  }
</style>
