---
import FeaturedLearningPath from "../components/home/FeaturedLearningPath.astro";
import HomeIntroduction from "../components/home/HomeIntroduction.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { summarizeCollection } from "../lib/collection";
import { getCompiledLessons } from "../lib/lessonCatalog";

/**
 * Home is curated, not a catalog. It presents the promise and one guided
 * starting point, and it reports what is actually published rather than what is
 * planned, so a partly written collection is never presented as a full library.
 *
 * The Domain Index and the search entry are deliberately absent. Both exist to
 * route to pages that do not exist yet, `/domains/<domain>/` from D03 and
 * `/explore/` from D02, and this page ships no link it cannot honour.
 */
const summary = summarizeCollection(
  await getCompiledLessons(),
  "interview-foundations",
);
---

<SiteLayout title="Knowledge Hub">
  <main id="main-content" class="home-main page-width" tabindex="-1">
    <HomeIntroduction />
    <FeaturedLearningPath summary={summary} />
  </main>
</SiteLayout>

<style>
  .home-main {
    display: grid;
    padding-block-end: var(--section-space);
  }
</style>
