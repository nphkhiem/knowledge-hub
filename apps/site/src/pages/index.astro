---
import DomainIndex from "../components/home/DomainIndex.astro";
import FeaturedLearningPath from "../components/home/FeaturedLearningPath.astro";
import HomeIntroduction from "../components/home/HomeIntroduction.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { summarizeCollection } from "../lib/collection";
import { summarizeDomains } from "../lib/domains";
import { getCompiledLessons } from "../lib/lessonCatalog";

/**
 * Home is curated, not a catalog. It presents the promise, one guided starting
 * point, and the domains, and it reports what is actually published rather than
 * what is planned, so a partly written collection is never presented as a full
 * library.
 *
 * The Domain Index renders only domains that have published lessons, because
 * those are the only ones with a route to link to.
 */
const lessons = await getCompiledLessons();
const summary = summarizeCollection(lessons, "interview-foundations");
const domains = summarizeDomains(lessons);
---

<SiteLayout title="Knowledge Hub">
  <main id="main-content" class="home-main page-width" tabindex="-1">
    <HomeIntroduction />
    <FeaturedLearningPath summary={summary} />
    <DomainIndex domains={domains} />
  </main>
</SiteLayout>

<style>
  .home-main {
    display: grid;
    padding-block-end: var(--section-space);
  }
</style>
