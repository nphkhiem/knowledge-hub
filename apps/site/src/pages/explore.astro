---
import LessonListRow from "../components/home/LessonListRow.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { domainLabel } from "../lib/collection";
import { getCompiledLessons } from "../lib/lessonCatalog";
import { toSearchRecord } from "../lib/search";
import { serializeForHtml } from "../lib/serializeForHtml";

/**
 * Explore renders the entire catalog as real markup and then lets a script
 * narrow it. A visitor without scripting therefore gets the complete browsable
 * library rather than an empty shell waiting for JavaScript.
 *
 * The consequence, which is deliberate: a shared `?q=` link needs scripting to
 * apply its filter, because a static host cannot filter server-side. Without
 * it, the link opens the full catalog, which is a useful page rather than a
 * broken one.
 */
const lessons = await getCompiledLessons();
const records = lessons.map(toSearchRecord);
const ordered = [...records].sort((left, right) => left.order - right.order);
const domains = [...new Set(ordered.map((record) => record.domain))].sort();
---

<SiteLayout
  title="Explore lessons"
  description="Search and filter every published Knowledge Hub lesson."
>
  <main id="main-content" class="explore-main page-width" tabindex="-1">
    <h1>Explore</h1>
    <p class="lede">
      Every published lesson. Search by name or by the signal you recognized.
    </p>

    <form
      class="controls"
      method="get"
      action="/explore/"
      data-explore-form
      role="search"
    >
      <div class="field">
        <label for="explore-query">Search lessons</label>
        <input
          id="explore-query"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="two pointers, dns, caching"
          data-explore-query
        />
      </div>
      <div class="field">
        <label for="explore-domain">Domain</label>
        <select id="explore-domain" name="domain" data-explore-domain>
          <option value="">All domains</option>
          {
            domains.map((domain) => (
              <option value={domain}>{domainLabel(domain)}</option>
            ))
          }
        </select>
      </div>
      <button type="submit">Search</button>
    </form>

    <p class="summary" data-explore-summary aria-live="polite">
      Showing all {ordered.length}
      {ordered.length === 1 ? "lesson" : "lessons"}.
    </p>

    <ol class="lesson-list" data-explore-results>
      {
        ordered.map((record, index) => (
          <LessonListRow
            lesson={{
              slug: record.slug,
              difficulty: record.difficulty,
              domain: record.domain,
              title: record.title,
              objective: record.objective,
              durationMinutes: record.durationMinutes,
              order: record.order,
            }}
            position={index + 1}
          />
        ))
      }
    </ol>

    <p class="empty" data-explore-empty hidden>
      No lesson matches that. Try a shorter term, clear the domain filter, or
      browse everything above.
    </p>

    <script
      type="application/json"
      data-search-index
      set:html={serializeForHtml(records)}
    />
  </main>
</SiteLayout>

<script>
  import { bootstrapExplore } from "../lib/bootstrapExplore";

  bootstrapExplore();
</script>

<style>
  .explore-main {
    padding-block: var(--section-space);
  }

  h1 {
    font-size: var(--font-size-3xl);
  }

  .lede {
    max-width: var(--max-width-prose);
    margin-block-start: var(--space-5);
    color: var(--color-text-secondary);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    margin-block-start: var(--space-8);
    gap: var(--space-5);
  }

  .field {
    display: grid;
    flex: 1 1 12rem;
    gap: var(--space-2);
  }

  label {
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  input,
  select,
  button {
    min-height: var(--control-target-min);
    padding: var(--space-3) var(--space-5);
    border: var(--border-width-thin) solid var(--color-border-secondary);
    border-radius: var(--border-radius-sm);
    background: var(--color-bg-secondary);
    color: inherit;
    font: inherit;
  }

  button {
    background: var(--color-accent-secondary);
    color: var(--color-bg-primary);
    cursor: pointer;
    font-weight: var(--font-weight-semibold);
  }

  .summary {
    margin-block-start: var(--space-7);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  .lesson-list {
    margin-block-start: var(--space-5);
    padding: 0;
    border-top: var(--border-width-thin) solid var(--color-border-subtle);
    list-style: none;
  }

  .empty {
    max-width: var(--max-width-prose);
    margin-block-start: var(--space-7);
    padding: var(--space-6);
    border-left: var(--border-width-strong) solid var(--color-accent-primary);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
  }
</style>
