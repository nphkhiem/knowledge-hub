---
import QuietGlobalHeader from "../components/site/QuietGlobalHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import SkipLink from "../components/site/SkipLink.astro";
import "../styles/global.css";

interface Props {
  description?: string;
  title: string;
}

const { description = "Visual mental models for software developers.", title } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <SkipLink />
    <QuietGlobalHeader />
    <slot />
    <SiteFooter />
  </body>
</html>
